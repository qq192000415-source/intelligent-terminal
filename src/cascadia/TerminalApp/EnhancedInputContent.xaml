<UserControl x:Class="TerminalApp.EnhancedInputContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid AllowDrop="True"
          Background="{ThemeResource UnfocusedBorderBrush}"
          DragOver="_onRootDragOver"
          Drop="_onRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: 面板头 -->
            <RowDefinition Height="Auto" />   <!-- 1: 标签栏 -->
            <RowDefinition Height="*" />      <!-- 2: 调色板区（内部滚动） -->
            <RowDefinition Height="Auto" />   <!-- 3: 悬停说明栏 -->
            <RowDefinition Height="Auto" />   <!-- 4: Composer -->
        </Grid.RowDefinitions>

        <!-- ① 面板头：标题 + 目标 pill + 清理截图 -->
        <Grid Grid.Row="0"
              Padding="12,10,12,10">
            <StackPanel HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="增强输入" />
                <TextBlock x:Name="TargetPill"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.5"
                           Text="→ 无活动终端" />
            </StackPanel>
            <Button x:Name="CleanupShotsButton"
                    HorizontalAlignment="Right"
                    Padding="6,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="_onCleanupShotsClick"
                    Content="🧹"
                    FontSize="13"
                    ToolTipService.ToolTip="清理截图缓存（~/.claude/shots）" />
        </Grid>

        <!-- ② 标签栏：快捷命令 | 技能 -->
        <Border Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button x:Name="CmdTabButton"
                        Padding="14,8"
                        Click="_onCmdTabClicked"
                        FontSize="12"
                        FontWeight="SemiBold">
                    <Button.Content>
                        <TextBlock>
                            快捷命令<Run x:Name="CmdCountRun"
                                     FontSize="10"
                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                    </Button.Content>
                </Button>
                <Button x:Name="SkillTabButton"
                        Padding="14,8"
                        Click="_onSkillTabClicked"
                        FontSize="12">
                    <Button.Content>
                        <TextBlock>技能<Run x:Name="SkillCountRun"
                                     FontSize="10"
                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>

        <!-- ③ 调色板区 -->
        <!-- 快捷命令页 -->
        <ScrollViewer x:Name="CmdScrollViewer"
                      Grid.Row="2"
                      Padding="12,8,12,4"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <!--  Built-in groups: filled programmatically in the C++ constructor.  -->
                <StackPanel x:Name="CommandGroupsPanel"
                            Spacing="14" />

                <!--  自定义 group: cards + "+ 添加" card, filled by _buildCustomCards.  -->
                <StackPanel x:Name="CustomGroupPanel"
                            Spacing="0" />

                <!--  Inline add form (Phase 6). Collapsed until "+ 添加" is clicked.  -->
                <StackPanel x:Name="CustomForm"
                            Spacing="6"
                            Visibility="Collapsed">
                    <TextBox x:Name="CustomCmdBox"
                             FontSize="12"
                             Header="命令（必填）"
                             PlaceholderText="/xxx 或任意文本" />
                    <TextBox x:Name="CustomTagBox"
                             FontSize="12"
                             Header="标签（选填）"
                             PlaceholderText="按钮上显示的短标签" />
                    <TextBox x:Name="CustomDescBox"
                             FontSize="12"
                             Header="说明（选填）"
                             PlaceholderText="悬停时底部说明栏显示" />
                    <TextBlock x:Name="CustomFormError"
                               FontSize="11"
                               Foreground="#FFE8686B"
                               Text="命令不能为空"
                               Visibility="Collapsed" />
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="6">
                        <Button x:Name="CustomFormCancelButton"
                                Click="_onCustomFormCancel"
                                Content="取消"
                                FontSize="12" />
                        <Button x:Name="CustomFormConfirmButton"
                                Click="_onCustomFormConfirm"
                                Content="添加"
                                FontSize="12"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 技能页：搜索框 + 刷新 + 卡片列表（阶段5，运行时扫描 ~/.claude/skills） -->
        <Grid x:Name="SkillPage"
              Grid.Row="2"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 搜索行 -->
                <RowDefinition Height="*" />      <!-- 列表 -->
            </Grid.RowDefinitions>

            <!-- 搜索框 + 刷新按钮 -->
            <Grid Grid.Row="0"
                  Padding="12,8,12,4"
                  ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SkillSearchBox"
                         Grid.Column="0"
                         FontSize="12"
                         PlaceholderText="搜索技能…"
                         TextChanged="_onSkillSearchChanged" />
                <Button x:Name="SkillRefreshButton"
                        Grid.Column="1"
                        Padding="10,6"
                        Click="_onSkillRefreshClick"
                        Content="↺"
                        FontSize="14"
                        ToolTipService.ToolTip="重新扫描技能" />
            </Grid>

            <!-- 列表（程序化填充）+ 空态提示叠加 -->
            <Grid Grid.Row="1">
                <ScrollViewer Padding="12,4,12,4"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SkillListPanel"
                                Spacing="6" />
                </ScrollViewer>
                <TextBlock x:Name="SkillEmptyHint"
                           Padding="12,8"
                           VerticalAlignment="Top"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- ④ 悬停说明栏（常驻，默认透明） -->
        <Border x:Name="HoverDescBar"
                Grid.Row="3"
                Padding="12,8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Opacity="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HoverDescCmd"
                           Grid.Column="0"
                           VerticalAlignment="Top"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SystemAccentColor}" />
                <TextBlock x:Name="HoverDescText"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="WrapWholeWords" />
            </Grid>
        </Border>

        <!-- ⑤ Composer（固定底部） -->
        <Border Grid.Row="4"
                Padding="8,8,8,10"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <!-- 错误条：发送失败时显示，草稿保留 -->
                <Border x:Name="ErrorBar"
                        Padding="10,6"
                        Background="#22D13438"
                        CornerRadius="3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               FontSize="11"
                               Foreground="#FFE8686B"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 附件行：每个附件独占一行（文件名 stretch + ✕），纵向堆叠。
                     限高可滚动，附件多时不横向溢出、也不把 Composer 顶走。
                     无附件时整个 scroller 收起。程序化填充 AttachmentRow。 -->
                <ScrollViewer x:Name="AttachmentScroller"
                              MaxHeight="150"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <!-- Small preview cards that flow left-to-right and wrap to the
                         next line (Codex-style, more compact). ItemWidth/Height fix
                         the card size; many attachments wrap + scroll, never overflow. -->
                    <VariableSizedWrapGrid x:Name="AttachmentRow"
                                           Orientation="Horizontal"
                                           ItemWidth="62"
                                           ItemHeight="62" />
                </ScrollViewer>

                <TextBox x:Name="Composer"
                         AcceptsReturn="False"
                         AllowDrop="True"
                         DragOver="_onRootDragOver"
                         Drop="_onRootDrop"
                         KeyDown="_onComposerKeyDown"
                         MaxHeight="160"
                         MinHeight="52"
                         Paste="_onComposerPaste"
                         PlaceholderText="输入内容，Enter 发送，Shift+Enter 换行…"
                         TextChanged="_onComposerTextChanged"
                         TextWrapping="Wrap" />

                <!-- 动作行：附件计数提示 + 发送按钮 -->
                <Grid>
                    <TextBlock x:Name="AttachmentHint"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button x:Name="SendButton"
                            HorizontalAlignment="Right"
                            Click="_onSendClick"
                            Content="发送"
                            IsEnabled="False"
                            Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
