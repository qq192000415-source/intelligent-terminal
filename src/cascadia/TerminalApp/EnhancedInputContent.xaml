<UserControl x:Class="TerminalApp.EnhancedInputContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid AllowDrop="True"
          Background="{ThemeResource UnfocusedBorderBrush}"
          DragOver="_onRootDragOver"
          Drop="_onRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: 面板头 -->
            <RowDefinition Height="Auto" />   <!-- 1: 标签栏 -->
            <RowDefinition Height="*" />      <!-- 2: 调色板区（内部滚动） -->
            <RowDefinition Height="Auto" />   <!-- 3: 悬停说明栏 -->
            <RowDefinition Height="Auto" />   <!-- 4: Composer -->
        </Grid.RowDefinitions>

        <!-- ① 面板头：标题 + 目标 pill + 清理截图 -->
        <Grid Grid.Row="0"
              Padding="12,10,12,10">
            <StackPanel HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock x:Name="PaneTitleText"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="增强输入" />
                <TextBlock x:Name="TargetPill"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.5"
                           Text="→ 无活动终端" />
            </StackPanel>
            <Button x:Name="CleanupShotsButton"
                    HorizontalAlignment="Right"
                    Padding="6,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="_onCleanupShotsClick"
                    Content="🧹"
                    FontSize="13"
                    ToolTipService.ToolTip="清理截图缓存（~/.claude/shots）" />
        </Grid>

        <!-- ② 标签栏：快捷命令 | 技能 | 便签 -->
        <Border x:Name="PaletteTabBar"
                Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button x:Name="CmdTabButton"
                        Padding="14,8"
                        Click="_onCmdTabClicked"
                        FontSize="12"
                        FontWeight="SemiBold">
                    <Button.Content>
                        <TextBlock>
                            快捷命令<Run x:Name="CmdCountRun"
                                     FontSize="10"
                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </TextBlock>
                    </Button.Content>
                </Button>
                <Button x:Name="SkillTabButton"
                        Padding="14,8"
                        Click="_onSkillTabClicked"
                        FontSize="12">
                    <Button.Content>
                        <TextBlock>技能<Run x:Name="SkillCountRun"
                                     FontSize="10"
                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
                    </Button.Content>
                </Button>
                <Button x:Name="NotesTabButton"
                        Padding="14,8"
                        Click="_onNotesTabClicked"
                        FontSize="12">
                    <Button.Content>
                        <TextBlock>便签<Run x:Name="NotesCountRun"
                                     FontSize="10"
                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></TextBlock>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>

        <!-- ③ 调色板区 -->
        <!-- 快捷命令页 -->
        <ScrollViewer x:Name="CmdScrollViewer"
                      Grid.Row="2"
                      Padding="12,8,12,4"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <!--  Built-in groups: filled programmatically in the C++ constructor.  -->
                <StackPanel x:Name="CommandGroupsPanel"
                            Spacing="14" />

                <!--  自定义 group: cards + "+ 添加" card, filled by _buildCustomCards.  -->
                <StackPanel x:Name="CustomGroupPanel"
                            Spacing="0" />

                <!--  Inline add form (Phase 6). Collapsed until "+ 添加" is clicked.  -->
                <StackPanel x:Name="CustomForm"
                            Spacing="6"
                            Visibility="Collapsed">
                    <TextBox x:Name="CustomCmdBox"
                             FontSize="12"
                             Header="命令（必填）"
                             PlaceholderText="/xxx 或任意文本" />
                    <TextBox x:Name="CustomTagBox"
                             FontSize="12"
                             Header="标签（选填）"
                             PlaceholderText="按钮上显示的短标签" />
                    <TextBox x:Name="CustomDescBox"
                             FontSize="12"
                             Header="说明（选填）"
                             PlaceholderText="悬停时底部说明栏显示" />
                    <TextBlock x:Name="CustomFormError"
                               FontSize="11"
                               Foreground="#FFE8686B"
                               Text="命令不能为空"
                               Visibility="Collapsed" />
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="6">
                        <Button x:Name="CustomFormCancelButton"
                                Click="_onCustomFormCancel"
                                Content="取消"
                                FontSize="12" />
                        <Button x:Name="CustomFormConfirmButton"
                                Click="_onCustomFormConfirm"
                                Content="添加"
                                FontSize="12"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 技能页：搜索框 + 刷新 + 卡片列表（阶段5，运行时扫描 ~/.claude/skills） -->
        <Grid x:Name="SkillPage"
              Grid.Row="2"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 搜索行 -->
                <RowDefinition Height="*" />      <!-- 列表 -->
            </Grid.RowDefinitions>

            <!-- 搜索框 + 刷新按钮 -->
            <Grid Grid.Row="0"
                  Padding="12,8,12,4"
                  ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SkillSearchBox"
                         Grid.Column="0"
                         FontSize="12"
                         PlaceholderText="搜索技能…"
                         TextChanged="_onSkillSearchChanged" />
                <Button x:Name="SkillRefreshButton"
                        Grid.Column="1"
                        Padding="10,6"
                        Click="_onSkillRefreshClick"
                        Content="↺"
                        FontSize="14"
                        ToolTipService.ToolTip="重新扫描技能" />
            </Grid>

            <!-- 列表（程序化填充）+ 空态提示叠加 -->
            <Grid Grid.Row="1">
                <ScrollViewer Padding="12,4,12,4"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SkillListPanel"
                                Spacing="6" />
                </ScrollViewer>
                <TextBlock x:Name="SkillEmptyHint"
                           Padding="12,8"
                           VerticalAlignment="Top"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- 便签页 -->
        <Grid x:Name="NotesPage"
              Grid.Row="2"
              Visibility="Collapsed">
            <Grid x:Name="NotesListWrap">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Padding="12,8,12,4"
                      ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NotesSearchBox"
                             Grid.Column="0"
                             FontSize="12"
                             PlaceholderText="搜索标题或正文…"
                             TextChanged="_onNotesSearchChanged" />
                    <Button x:Name="NotesNewButton"
                            Grid.Column="1"
                            Click="_onNotesNewClick"
                            Content="＋ 新建"
                            FontSize="12" />
                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer Padding="12,4,12,4"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NotesListPanel"
                                    Spacing="8" />
                    </ScrollViewer>
                    <TextBlock x:Name="NotesEmptyHint"
                               Padding="12,8"
                               VerticalAlignment="Top"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="还没有便签。把常用提示词存在这里。左键填进终端，双击编辑。"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>

            <Grid x:Name="NotesEditor"
                  Padding="12,8,12,8"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="NotesBackButton"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Click="_onNotesBackClick"
                        Content="← 返回列表"
                        FontSize="12" />
                <TextBox x:Name="NotesTitleBox"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         FontSize="12"
                         PlaceholderText="标题（选填，不填则列表不显示标题）" />
                <TextBox x:Name="NotesBodyBox"
                         Grid.Row="2"
                         Margin="0,8,0,0"
                         AcceptsReturn="True"
                         FontSize="12"
                         PlaceholderText="提示词正文（必填）"
                         TextWrapping="Wrap" />
                <TextBlock x:Name="NotesBodyError"
                           Grid.Row="3"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="#FFE8686B"
                           Text="正文不能为空"
                           Visibility="Collapsed" />
                <Grid Grid.Row="4"
                      Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <Button x:Name="NotesSaveButton"
                                Click="_onNotesSaveClick"
                                Content="保存"
                                FontSize="12"
                                Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="NotesCopyButton"
                                Click="_onNotesCopyClick"
                                Content="复制"
                                FontSize="12" />
                    </StackPanel>
                    <Button x:Name="NotesDeleteButton"
                            HorizontalAlignment="Right"
                            Click="_onNotesDeleteClick"
                            Content="删除"
                            FontSize="12" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ④ 悬停说明栏（常驻，默认透明） -->
        <Border x:Name="HoverDescBar"
                Grid.Row="3"
                Padding="12,8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Opacity="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HoverDescCmd"
                           Grid.Column="0"
                           VerticalAlignment="Top"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SystemAccentColor}" />
                <TextBlock x:Name="HoverDescText"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="WrapWholeWords" />
            </Grid>
        </Border>

        <!-- ⑤ Composer（默认可折叠、默认收起） -->
        <Border x:Name="ComposerBar"
                Grid.Row="4"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <Button x:Name="ComposerToggle"
                        Padding="12,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="_onComposerToggle"
                        Content="输入框 ▾ 展开"
                        FontSize="12" />
                <StackPanel x:Name="ComposerBody"
                            Padding="8,0,8,10"
                            Spacing="6"
                            Visibility="Collapsed">
                <!-- 错误条：发送失败时显示，草稿保留 -->
                <Border x:Name="ErrorBar"
                        Padding="10,6"
                        Background="#22D13438"
                        CornerRadius="3"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               FontSize="11"
                               Foreground="#FFE8686B"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 附件行：每个附件独占一行（文件名 stretch + ✕），纵向堆叠。
                     限高可滚动，附件多时不横向溢出、也不把 Composer 顶走。
                     无附件时整个 scroller 收起。程序化填充 AttachmentRow。 -->
                <ScrollViewer x:Name="AttachmentScroller"
                              MaxHeight="150"
                              HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <!-- Small preview cards that flow left-to-right and wrap to the
                         next line (Codex-style, more compact). ItemWidth/Height fix
                         the card size; many attachments wrap + scroll, never overflow. -->
                    <VariableSizedWrapGrid x:Name="AttachmentRow"
                                           Orientation="Horizontal"
                                           ItemWidth="62"
                                           ItemHeight="62" />
                </ScrollViewer>

                <TextBox x:Name="Composer"
                         AcceptsReturn="False"
                         AllowDrop="True"
                         DragOver="_onRootDragOver"
                         Drop="_onRootDrop"
                         KeyDown="_onComposerKeyDown"
                         MaxHeight="160"
                         MinHeight="52"
                         Paste="_onComposerPaste"
                         PlaceholderText="输入内容，Enter 发送，Shift+Enter 换行…"
                         TextChanged="_onComposerTextChanged"
                         TextWrapping="Wrap" />

                <!-- 动作行：附件计数提示 + 发送按钮 -->
                <Grid>
                    <TextBlock x:Name="AttachmentHint"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button x:Name="SendButton"
                            HorizontalAlignment="Right"
                            Click="_onSendClick"
                            Content="发送"
                            IsEnabled="False"
                            Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>
            </StackPanel>
        </Border>

        <!-- 插件市场（InputPaneMode::Plugins）。与命令/技能/Composer 互斥。 -->
        <Grid x:Name="PluginMarketplaceRoot"
              Grid.Row="1"
              Grid.RowSpan="4"
              Padding="14,8,14,12"
              Visibility="Collapsed">
            <Grid x:Name="PluginMarketHome">
                <ScrollViewer HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="先装 GitHub 云端存档。其它插件以后用同一套安装 → 登录。"
                                   TextWrapping="Wrap" />
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Opacity="0.7"
                                   Text="已安装" />
                        <Border Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                            <TextBlock x:Name="PluginInstalledHint"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="还没有插件。从下面点「安装」开始。" />
                        </Border>
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Opacity="0.7"
                                   Text="公开" />
                        <Grid Padding="10"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              ColumnSpacing="10"
                              CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="GitHub 云端存档" />
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="把文件保存到网上。换电脑登录同一个号就能取回。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="PluginGithubInstallButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="_onPluginGithubInstall"
                                    Content="安装"
                                    FontSize="12"
                                    Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                        <Grid Padding="10"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              CornerRadius="8"
                              Opacity="0.55">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="Gmail" />
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="以后同一套安装 → 登录" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="_onPluginSoonClick"
                                    Content="即将推出"
                                    FontSize="11" />
                        </Grid>
                        <Grid Padding="10"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              CornerRadius="8"
                              Opacity="0.55">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="Slack" />
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="以后同一套安装 → 登录" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="_onPluginSoonClick"
                                    Content="即将推出"
                                    FontSize="11" />
                        </Grid>
                        <TextBlock x:Name="PluginHomeStatus"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="PluginWizardRoot"
                  Background="{ThemeResource UnfocusedBorderBrush}"
                  Visibility="Collapsed">
                <StackPanel VerticalAlignment="Top"
                            Spacing="12">
                    <TextBlock x:Name="PluginWizardTitle"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="这台电脑还没连上 GitHub" />
                    <TextBlock x:Name="PluginWizardLead"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="按从来没登过设计。不需要记命令。"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="PluginWizardStep0"
                                Spacing="8">
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="_onPluginHasAccount"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="我已经有 GitHub 账号" />
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="下一步用浏览器登录，看清右上角是不是你的号" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="_onPluginNoAccount"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="还没有账号" />
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="先去 GitHub 注册（邮箱、密码、验证码），回来再登录" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="PluginWizardStep1"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="真机会打开 github.com/signup。用邮箱、密码、验证码即可。不要填 token 或 SSH。" />
                        <Button Click="_onPluginOpenSignup"
                                Content="去注册"
                                Style="{ThemeResource AccentButtonStyle}" />
                        <Button Click="_onPluginSignupDone"
                                Content="我注册好了，去登录" />
                    </StackPanel>
                    <StackPanel x:Name="PluginWizardStep2"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="请看网页右上角头像。必须是你自己的号。登错就先退出再登，不要点授权。" />
                        <Button Click="_onPluginOpenLogin"
                                Content="打开 GitHub 登录"
                                Style="{ThemeResource AccentButtonStyle}" />
                        <Button Click="_onPluginLoginDone"
                                Content="我登录好了" />
                    </StackPanel>
                    <StackPanel x:Name="PluginWizardStep3"
                                Spacing="8"
                                Visibility="Collapsed">
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="_onPluginNewRepo"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="新建云端仓库（推荐）" />
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="默认私有。第一期只记下选择，下一期才真正创建。" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="_onPluginExistingRepo"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="连到已有仓库" />
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="换电脑取回时用。" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="PluginWizardStep4"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock x:Name="PluginMetaAccount"
                                   FontSize="12"
                                   Text="账号：还没登录" />
                        <TextBlock x:Name="PluginMetaFolder"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="这个文件夹：—" />
                        <TextBlock x:Name="PluginMetaRepo"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="网上仓库：还没有" />
                        <TextBox x:Name="PluginCommitMessage"
                                 FontSize="12"
                                 Header="这一版叫什么（可空）"
                                 PlaceholderText="空着会自动写成今天的存档名" />
                        <CheckBox x:Name="PluginIncludeUnstaged"
                                  Content="把还没保存的文件也算进去"
                                  IsChecked="True" />
                        <Button x:Name="PluginBtnCommitPush"
                                Click="_onPluginUpload"
                                Content="存档并上传到网上"
                                HorizontalAlignment="Stretch"
                                Style="{ThemeResource AccentButtonStyle}" />
                        <Button x:Name="PluginBtnLocal"
                                Click="_onPluginSave"
                                Content="只存到这台电脑"
                                HorizontalAlignment="Stretch" />
                        <Button x:Name="PluginBtnPush"
                                Click="_onPluginPushOnly"
                                Content="只上传"
                                HorizontalAlignment="Stretch" />
                        <Button x:Name="PluginBtnPull"
                                Click="_onPluginDownload"
                                Content="从网上取回"
                                HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="PluginWizardStatus"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Button Click="_onPluginWizardBackHome"
                                Content="回到插件页" />
                    </StackPanel>
                    <Button x:Name="PluginWizardClose"
                            Click="_onPluginWizardBackHome"
                            Content="关闭向导" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
